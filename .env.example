# Supabase project settings — find these in
# Supabase Dashboard -> Project Settings -> API
#
# The URL looks like https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon (public) API key. Safe to expose to the browser — row-level
# security is what actually protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service access for trusted API routes and the Mac Studio worker.
# Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Self-serve iPhone beta — server-only. Use the approved public invitation
# from App Store Connect, for example https://testflight.apple.com/join/Ab12Cd34.
IOS_TESTFLIGHT_URL=

# Transactional email for beta access, review updates, and receipts.
RESEND_API_KEY=

# Authorizes Vercel's daily recovery sweep for pending transactional email.
CRON_SECRET=

# Cloudflare R2 — server-only (used by /api/upload-url and
# /api/download-url to mint presigned URLs). Values live in the macOS
# Keychain (ponglens-r2-account / ponglens-r2-key-id / ponglens-r2-secret)
# and in Vercel env vars. NEVER prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Stripe — server-only, set on Vercel, never in this file for real.
# STRIPE_SECRET_KEY powers coach Connect payments AND platform purchases
# (096). STRIPE_WEBHOOK_SECRET verifies the Connect endpoint
# (/api/stripe/webhook); STRIPE_PLATFORM_WEBHOOK_SECRET verifies the
# platform endpoint (/api/stripe/platform-webhook) — two Stripe webhook
# subscriptions, two secrets. STRIPE_FAKE=1 swaps in the keyless fake
# gateway for local walkthroughs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_WEBHOOK_SECRET=
