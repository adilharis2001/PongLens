      "text": "PongLens is a performance hub for competitive table tennis.",
      "file": "audio/landing/l1.mp3",
      "start": 0.3,
      "dur": 4.872
    },
    {
      "id": "l2",
      "beat": "upload",
      "text": "Get any match in from your phone, or straight from YouTube.",
