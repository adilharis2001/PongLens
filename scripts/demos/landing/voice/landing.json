      "start": 5.822,
      "dur": 4.416
    },
    {
      "id": "l3",
      "beat": "playback1",
      "text": "It comes back as pure table tennis. The standing around is gone, and what is left is every point you played.",
      "file": "audio/landing/l3.mp3",
      "start": 10.788,
      "dur": 8.52
