# Everything here is regenerated by the pipeline, and the finished chapters
# live in R2 (see publish.mjs), not in the repo. What IS worth versioning is
# the source that produces them: the .mjs drivers, chapters/, flows/,
# voice/, remotion/src and SCRIPT.md — re-run those after a UI change and a
# chapter re-records itself.

node_modules/

# Rendered chapters. ~57 MB, and publish.mjs puts them in
# r2://ponglens-media/tutorial/ where the app reads them from.
out/

# Screencast frames and cue tracks from the last capture run, plus the guard
# snapshots used to undo the writes a capture makes to real data.
raw/

# TTS output. Regenerated by tts.mjs; voice/*.json holds the narration and
# the measured line durations that the capture actually times against.
audio/

# Staging: render-b.mjs copies the chapter being rendered in here, so it is
# whichever chapter ran last rather than anything durable.
remotion/public/
