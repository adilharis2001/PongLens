{
  "name": "ponglens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SUPABASE_SERVICE_ROLE_KEY=$(security find-generic-password -a openclaw -s ponglens-service-role -w 2>/dev/null) next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "node --test --experimental-strip-types src/lib/auth/*.test.ts",
    "test:learn": "node --test --experimental-strip-types src/app/learn/guides.test.ts",
    "test:match-structure": "node --test --experimental-strip-types 'src/app/match/[[]id[]]/matchStructure.test.ts' 'src/app/match/[[]id[]]/gameScore.test.ts' 'src/app/match/[[]id[]]/playhead.test.ts' 'src/app/match/[[]id[]]/tapZone.test.ts' src/lib/research/matchStructureMigration.test.ts 'src/app/match/[[]id[]]/highlights.test.ts'",
    "test:costs": "node --test --experimental-strip-types src/lib/costs/*.test.ts src/app/admin/costDashboardView.test.ts src/app/admin/adminPageView.test.ts src/app/admin/players/playersView.test.ts",
    "test:placement": "node --test --experimental-strip-types src/lib/placement/*.test.ts",
    "test:scorecard": "node --test --experimental-strip-types 'src/app/match/[[]id[]]/scorecard.test.ts'",
    "test:matches": "node --test --experimental-strip-types src/app/matches/*.test.ts",
    "test:research": "node --test --experimental-strip-types src/lib/research/*.test.ts src/app/research/researchDashboard.test.ts src/app/research/crossing-review/crossingReviewView.test.ts src/app/research/serve-detector/serveDetectorView.test.ts src/app/research/recall/recallView.test.ts src/app/research/spin/serveSpinView.test.ts src/app/research/serve-accuracy/segments.test.ts",
    "test:journal": "node --test --experimental-strip-types src/lib/journal/*.test.ts src/lib/recollect/*.test.ts",
    "test:marketing": "node --test --experimental-strip-types src/app/marketing/marketingDashboard.test.ts src/app/marketing/coach-outreach/outreach.test.ts scripts/marketing/language.test.ts scripts/marketing/notify.test.ts src/lib/marketing/voice.test.ts",
    "test:upload": "node --test --experimental-strip-types src/components/youtubeVideoId.test.ts src/app/dashboard/pendingUploads.test.ts src/lib/cameraGuideGate.test.ts",
    "test:reviews": "node --test --experimental-strip-types src/lib/reviews/*.test.ts src/lib/payments/*.test.ts",
    "test:backlog": "node --test --experimental-strip-types src/lib/backlog/*.test.ts src/app/admin/adminPageView.test.ts",
    "test:ask": "node --test --experimental-strip-types src/lib/ask/*.test.ts",
    "test:commerce": "node --test --experimental-strip-types src/lib/commerce/*.test.ts",
    "test:qa": "node --test --experimental-strip-types src/lib/qa/*.test.ts",
    "qa:affected": "node --experimental-strip-types scripts/qa/affected.ts",
    "test:email": "node --test --experimental-strip-types src/lib/email/*.test.ts",
    "test:starred": "node --test --experimental-strip-types src/app/starred/starred.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@vercel/analytics": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "motion": "^12.42.2",
    "next": "^15.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.4",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
