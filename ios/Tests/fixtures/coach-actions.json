{
  "_comment": [
    "The coach-action rules, written down once. Neither platform produces this",
    "table: src/lib/coaches/coachActions.ts and Core/CoachActions.swift are both",
    "checked AGAINST it, so comparing two ports cannot degenerate into reading",
    "the same paragraph twice and making the same mistake twice.",
    "A state added on one platform and not the other fails here.",
    "Spec: docs/superpowers/specs/2026-09-10-player-coach-management-design.md"
  ],

  "tabDoor": [
    { "name": "still reading", "coaches": 0, "pending": 0, "state": "loading", "expected": "loading" },
    { "name": "a brand new account", "coaches": 0, "pending": 0, "state": "ready", "expected": "empty" },
    { "name": "one written-down coach hides nothing", "coaches": 1, "pending": 0, "state": "ready", "expected": "row" },
    { "name": "an unnamed invite alone still needs the door", "coaches": 0, "pending": 1, "state": "ready", "expected": "row" },
    { "name": "coaches and invites together", "coaches": 4, "pending": 2, "state": "ready", "expected": "row" },
    { "name": "a dropped request is not an empty list", "coaches": 0, "pending": 0, "state": "failed", "expected": "error" },
    { "name": "a dropped request with coaches known is still an error", "coaches": 3, "pending": 0, "state": "failed", "expected": "error" }
  ],

  "invitesWaiting": [
    { "n": 0, "expected": null },
    { "n": 1, "expected": "1 invite waiting" },
    { "n": 2, "expected": "2 invites waiting" },
    { "n": 11, "expected": "11 invites waiting" }
  ],

  "canSendInvite": [
    { "status": "offline", "expected": true },
    { "status": "past", "expected": true },
    { "status": "invited", "expected": false },
    { "status": "connected", "expected": false }
  ],

  "canEndAccess": [
    { "status": "connected", "expected": true },
    { "status": "invited", "expected": false },
    { "status": "offline", "expected": false },
    { "status": "past", "expected": false }
  ],

  "standingWords": [
    { "status": "connected", "expected": "Connected" },
    { "status": "invited", "expected": "Invite waiting" },
    { "status": "past", "expected": "No longer connected" },
    { "status": "offline", "expected": "Not on PongLens" }
  ],

  "accessLine": [
    { "name": "connected with an access line", "status": "connected", "hasAccount": true, "access": "All matches", "expected": "Connected · All matches" },
    { "name": "connected, nothing shared", "status": "connected", "hasAccount": true, "access": "No matches shared", "expected": "Connected · No matches shared" },
    { "name": "no account means no access half", "status": "offline", "hasAccount": false, "access": "Not connected", "expected": "Not on PongLens" },
    { "name": "an invite has no account yet either", "status": "invited", "hasAccount": false, "access": "Not connected", "expected": "Invite waiting" },
    { "name": "past keeps the account but has no access", "status": "past", "hasAccount": true, "access": null, "expected": "No longer connected" }
  ],

  "duplicateNotice": [
    {
      "name": "a name nobody on the list has",
      "typed": "Marta",
      "rows": [
        { "id": "11111111-1111-4111-8111-111111111111", "coach_id": null, "display_name": "Jonathan", "coach_email": null, "invite_id": null, "status": "offline", "entry_count": 0, "shared_count": 0 }
      ],
      "expected": null
    },
    {
      "name": "a written-down coach is adopted, not duplicated",
      "typed": "Jonathan",
      "rows": [
        { "id": "11111111-1111-4111-8111-111111111111", "coach_id": null, "display_name": "Jonathan", "coach_email": null, "invite_id": null, "status": "offline", "entry_count": 3, "shared_count": 0 }
      ],
      "expected": { "line": "Jonathan is already on your list. This invite goes to them.", "action": "invite-this-row" }
    },
    {
      "name": "casing and stray spaces do not make a second person",
      "typed": "  jONATHAN  ",
      "rows": [
        { "id": "11111111-1111-4111-8111-111111111111", "coach_id": null, "display_name": "Jonathan", "coach_email": null, "invite_id": null, "status": "offline", "entry_count": 0, "shared_count": 0 }
      ],
      "expected": { "line": "Jonathan is already on your list. This invite goes to them.", "action": "invite-this-row" }
    },
    {
      "name": "a coach you parted with can be invited back in place",
      "typed": "Dave",
      "rows": [
        { "id": "22222222-2222-4222-8222-222222222222", "coach_id": "33333333-3333-4333-8333-333333333333", "display_name": "Dave", "coach_email": "dave@example.com", "invite_id": null, "status": "past", "entry_count": 9, "shared_count": 2 }
      ],
      "expected": { "line": "Dave is already on your list. This invite goes to them.", "action": "invite-this-row" }
    },
    {
      "name": "a second invite to the same person is refused, not silently adopted",
      "typed": "Dave",
      "rows": [
        { "id": "22222222-2222-4222-8222-222222222222", "coach_id": null, "display_name": "Dave", "coach_email": null, "invite_id": "44444444-4444-4444-8444-444444444444", "status": "invited", "entry_count": 0, "shared_count": 0 }
      ],
      "expected": { "line": "Dave already has an invite waiting.", "action": "open-their-page" }
    },
    {
      "name": "already connected",
      "typed": "Dave",
      "rows": [
        { "id": "22222222-2222-4222-8222-222222222222", "coach_id": "33333333-3333-4333-8333-333333333333", "display_name": "Dave", "coach_email": "dave@example.com", "invite_id": null, "status": "connected", "entry_count": 12, "shared_count": 4 }
      ],
      "expected": { "line": "Dave is already connected.", "action": "open-their-page" }
    },
    {
      "name": "an empty name recognises nobody",
      "typed": "   ",
      "rows": [
        { "id": "11111111-1111-4111-8111-111111111111", "coach_id": null, "display_name": "Jonathan", "coach_email": null, "invite_id": null, "status": "offline", "entry_count": 0, "shared_count": 0 }
      ],
      "expected": null
    }
  ],

  "removeConfirm": [
    {
      "status": "connected", "name": "Jonathan",
      "expected": {
        "title": "Remove Jonathan from your list?",
        "body": "They stop seeing your matches and the entries you shared with them. Your lessons keep their name.",
        "confirmLabel": "Remove"
      }
    },
    {
      "status": "invited", "name": "Dave",
      "expected": {
        "title": "Remove Dave from your list?",
        "body": "The invite stops working and cannot be restarted. Your lessons keep their name.",
        "confirmLabel": "Remove"
      }
    },
    {
      "status": "offline", "name": "Kory",
      "expected": {
        "title": "Remove Kory from your list?",
        "body": "Your lessons keep their name.",
        "confirmLabel": "Remove"
      }
    },
    {
      "status": "past", "name": "Marta",
      "expected": {
        "title": "Remove Marta from your list?",
        "body": "Your lessons keep their name.",
        "confirmLabel": "Remove"
      }
    }
  ],

  "endAccessConfirm": [
    {
      "name": "Jonathan",
      "expected": {
        "title": "End their access?",
        "body": "Jonathan stops seeing your matches and the entries you shared with them. They stay on your list and your lessons keep their name.",
        "confirmLabel": "End access"
      }
    }
  ],

  "restoreNotice": [
    { "status": "offline", "expected": "The invite you sent them was cancelled. Send a new one." },
    { "status": "past", "expected": null },
    { "status": "connected", "expected": null },
    { "status": "invited", "expected": null }
  ],

  "inviteWaitingLine": [
    { "revokeIsHere": true, "expected": "It is waiting until they open it. You can revoke it any time." },
    { "revokeIsHere": false, "expected": "It is waiting until they open it. You can revoke it from their page under Your coaches." }
  ]
}
