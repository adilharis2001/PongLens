<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!--
	  Sharing a rally to Instagram. These live in the real Info.plist, not
	  in INFOPLIST_KEY_* build settings: on this project
	  INFOPLIST_KEY_UIBackgroundModes once expanded to nothing and the key
	  never reached the built app. Verify by reading Info.plist out of the
	  built .app, never the build setting.

	  Without LSApplicationQueriesSchemes, canOpenURL answers false for
	  these schemes even when Instagram is installed — so a missing entry
	  here is indistinguishable from a missing Instagram, and the share row
	  simply never appears.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram-reels</string>
	</array>
	<!--
	  Hand cut on iPhone (spec 2026-09-24): continued processing tasks, so
	  a cut the player started keeps encoding with the app in the
	  background. Wildcard notation, as BGContinuedProcessingTaskRequest
	  requires: the bundle id, a context, then ".*"; each submission adds
	  its own suffix. Must be DeviceHandCutQueue.taskPrefix plus ".*". An
	  array, so it lives here and not in an INFOPLIST_KEY_* build setting.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ponglens.PongLens.handcut.*</string>
	</array>
	<!-- Must match AppConfig.metaAppID. -->
	<key>FacebookAppID</key>
	<string>1012434688493595</string>
</dict>
</plist>
