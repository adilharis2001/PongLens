# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.worktrees/
/.superpowers/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is safe to commit
!.env.example

# worker runtime logs
worker/*.log
worker/venv/
worker/eval/*/cache/
/worker/eval/service-motion-first-server-20260730/results.json
__pycache__/
src/app/api/dev-login-*
scripts/demos/raw/

# Coach outreach worker logs and rotation state
scripts/marketing/logs/
scripts/marketing/outreach-state.json

# Serve-diagnosis backfill: the work directory holds a raw upload and a
# blurball jsonl per match while it runs, and the state file is just which
# ids this machine has already published.
.backfill-work/
worker/backfill-serve-misses.state
